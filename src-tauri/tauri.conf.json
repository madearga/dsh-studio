{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Studio",
  "version": "1.0.0",
  "identifier": "id.madearga.dshstudio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/backend": "backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "DSH Studio",
    "longDescription": "Native desktop window for the dsh web coding agent."
  }
}
